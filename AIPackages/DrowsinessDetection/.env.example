# Copy to .env (do not commit real secrets).

DROWSINESS_CHECKPOINT_PATH=saved_weights/best_loss_v3.pt
DROWSINESS_API_KEY=replace-with-a-long-random-value
DROWSINESS_DEVICE=auto
DROWSINESS_HOST=0.0.0.0
DROWSINESS_PORT=8001

