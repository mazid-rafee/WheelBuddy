# Secrets.example.xcconfig
# Copy to Secrets.xcconfig (gitignored) and fill in keys restricted to:
# - Wheel Buddy iOS bundle identifier (com.zaimazarnaz.drivesensai)
# - Maps SDK for iOS, Places API, Navigation SDK for iOS, Routes API
# - Roads API (Speed Limits / Asset Tracking) for posted MPH beside the speed cluster

MAPS_API_KEY = REPLACE_WITH_MAPS_API_KEY
ROUTES_API_KEY = REPLACE_WITH_ROUTES_API_KEY

# Optional shared secret for the local DrowsinessDetection FastAPI (X-API-Key).
DROWSINESS_API_KEY = REPLACE_WITH_DROWSINESS_API_KEY
